@model StudentModel

<table class="table table-bordered">
<tr>
<td>Full Name</td>
<td>: @Model.FullName</td>
</tr>
<tr>
<td>Age</td>
<td>: @Model.Age</td>
</tr>
<tr>
<td>Gender</td>
<td>: @Model.Gender</td>
</tr>
<tr>
<td>Date of Birth</td>
<td>: @Model.DateOfBirth.ToString("yyyy-MM-dd")</td>
</tr>
</table>