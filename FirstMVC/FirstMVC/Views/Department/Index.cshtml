@model List<Department>

<div class="row">
    <div class="col-md-6">
        <h4>Department List:</h4>
    </div>
    <div class="col-md-12">
        <a class="float-end btn btn-primary" asp-controller="Department" asp-action="Create">Create</a>
    </div>
</div>

<table class="table table-bordered">
    <tr>
        <th>Ref</th>
        <th>Name</th>
<th>Actions</th>
</tr>

    @foreach (var department in Model)
    {
        <tr>
            <td>@department.Id</td>
            <td>@department.Title</td>
            <td>
                <a class="btn btn-info" asp-controller="Department" asp-action="Edit" asp-route-did="@department.Id">Edit</a>
                <a class="btn btn-danger" asp-controller="Department" asp-action="Delete" asp-route-did="@department.Id">Delete</a>
            </td>
        </tr>
    }
</table>
